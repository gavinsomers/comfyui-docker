**/outputs/

# Input directories
input/
inputs/
**/input/

# Temporary files
temp/
tmp/
**/temp/

# ============================================================================
# Python Environment
# ============================================================================

# Virtual environments
venv/
env/
ENV/
.venv/
**/venv/

# Python cache
__pycache__/
*.py[cod]
*~
*.so
*.egg
*.egg-info/
dist/
build/
.Python

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

