{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Video factory project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "profile",
    "subject",
    "presenter",
    "voice",
    "content",
    "engines"
  ],
  "properties": {
    "version": {"const": 1},
    "seed": {"type": "integer", "minimum": 0},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "profile": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["topic", "product", "environment"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "audience": {"type": "string"}
      }
    },
    "presenter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "animation_prompt"],
      "properties": {
        "mode": {"enum": ["generated", "supplied"]},
        "image": {"type": "string"},
        "image_engine": {"type": "string"},
        "image_prompt": {"type": "string"},
        "animation_prompt": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sample_fps": {"type": "integer", "minimum": 1, "maximum": 60},
            "minimum_mouth_motion_mean": {"type": "number", "minimum": 0},
            "minimum_mouth_motion_p95": {"type": "number", "minimum": 0}
          }
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motion_engine", "lip_sync_engine", "driving_asset"],
          "properties": {
            "motion_engine": {"type": "string", "minLength": 1},
            "lip_sync_engine": {"type": "string", "minLength": 1},
            "driving_asset": {"type": "string", "minLength": 1},
            "driving_frame_capacity": {"type": "integer", "minimum": 1},
            "fps": {"type": "integer", "minimum": 1, "maximum": 60},
            "lip_sync_options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mask": {"const": "mask3"},
                "inference_steps": {"type": "integer", "minimum": 1, "maximum": 100},
                "guidance_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
                "enable_deepcache": {"type": "boolean"},
                "pad_x": {"type": "number", "minimum": 0},
                "pad_y": {"type": "number", "minimum": 0},
                "minimum_radius_x": {"type": "number", "exclusiveMinimum": 0},
                "minimum_radius_y": {"type": "number", "exclusiveMinimum": 0},
                "feather_sigma": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "generated"}}},
          "then": {"required": ["image_prompt"]}
        },
        {
          "if": {"properties": {"mode": {"const": "supplied"}}},
          "then": {"required": ["image"]}
        }
      ]
    },
    "voice": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "engine"],
      "properties": {
        "mode": {"enum": ["custom_voice", "supplied"]},
        "engine": {"type": "string", "minLength": 1},
        "audio": {"type": "string"},
        "speaker": {"type": "string"},
        "instruct": {"type": "string"},
        "language": {"type": "string"},
        "seed": {"type": "integer", "minimum": 0},
        "target_words_per_minute": {"type": "number", "minimum": 60, "maximum": 240},
        "max_new_tokens": {"type": "integer", "minimum": 64}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "supplied"}}},
          "then": {"required": ["audio"]}
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_file"],
      "properties": {
        "script_file": {"type": "string", "minLength": 1},
        "storyboard_file": {"type": "string", "minLength": 1},
        "timing_file": {"type": "string", "minLength": 1}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "global": {"type": "string"},
        "broll": {"type": "string"},
        "still": {"type": "string"},
        "constraints": {"type": "string"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"enum": ["image", "video", "audio", "lut"]},
              "required": {"type": "boolean"},
              "license": {"type": "string"},
              "source_url": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre_grade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fps_method": {"enum": ["duplicate", "blend"]},
            "denoise": {"type": "number", "minimum": 0},
            "sharpen": {"type": "number", "minimum": -2, "maximum": 2},
            "contrast": {"type": "number", "minimum": 0},
            "brightness": {"type": "number", "minimum": -1, "maximum": 1},
            "saturation": {"type": "number", "minimum": 0},
            "gamma": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
            "blue_shadows": {"type": "number", "minimum": -1, "maximum": 1},
            "blue_midtones": {"type": "number", "minimum": -1, "maximum": 1},
            "blue_highlights": {"type": "number", "minimum": -1, "maximum": 1},
            "source_crop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": {"type": "integer", "minimum": 0},
                "y": {"type": "integer", "minimum": 0},
                "width": {"type": "integer", "minimum": 1},
                "height": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "final_grade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lut_path": {"type": "string"},
            "warmth": {"type": "number", "minimum": -1, "maximum": 1},
            "grain": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presenter", "broll", "still"],
      "properties": {
        "presenter": {"type": "string", "minLength": 1},
        "broll": {"type": "string", "minLength": 1},
        "still": {"type": "string", "minLength": 1}
      }
    }
  }
}
