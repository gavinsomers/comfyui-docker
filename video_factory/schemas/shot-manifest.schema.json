{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shot-manifest.schema.json",
  "title": "Compiled video factory shot manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "project",
    "format_profile",
    "duration",
    "delivery",
    "shots"
  ],
  "properties": {
    "version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "format_profile": {"type": "string", "minLength": 1},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "word_count": {"type": "integer", "minimum": 1},
    "delivery": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 64},
        "height": {"type": "integer", "minimum": 64},
        "fps": {"type": "integer", "minimum": 1}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "shot_id",
          "index",
          "type",
          "engine",
          "start",
          "end",
          "duration",
          "narration",
          "prompt",
          "seed"
        ],
        "properties": {
          "shot_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "index": {"type": "integer", "minimum": 1},
          "type": {"enum": ["presenter", "broll", "still"]},
          "engine": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "narration": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "seed": {"type": "integer", "minimum": 0},
          "pre_grade": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fps_method": {"enum": ["duplicate", "blend"]},
              "denoise": {"type": "number", "minimum": 0},
              "sharpen": {"type": "number", "minimum": -2, "maximum": 2},
              "contrast": {"type": "number", "minimum": 0},
              "brightness": {"type": "number", "minimum": -1, "maximum": 1},
              "saturation": {"type": "number", "minimum": 0},
              "gamma": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
              "blue_shadows": {"type": "number", "minimum": -1, "maximum": 1},
              "blue_midtones": {"type": "number", "minimum": -1, "maximum": 1},
              "blue_highlights": {"type": "number", "minimum": -1, "maximum": 1},
              "source_crop": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": {"type": "integer", "minimum": 0},
                  "y": {"type": "integer", "minimum": 0},
                  "width": {"type": "integer", "minimum": 1},
                  "height": {"type": "integer", "minimum": 1}
                }
              }
            }
          },
          "asset": {"type": ["string", "null"]},
          "status": {"type": "string"}
        }
      }
    }
  }
}
